#!/bin/sh
# Pre-commit privacy guard.
#
# Blocks any commit whose STAGED ADDITIONS contain a token listed in
# .pii-denylist.txt (gitignored, local-only) — real emails, account
# ids, or distinctive financial figures.  This is a mechanical gate:
# it runs on every `git commit` regardless of who (or what) is
# committing, so personal data can't reach a tracked file — and thus
# can't be pushed — even if the author forgets.
#
# Enable once per clone:
#     git config core.hooksPath githooks
#
# Bypass (discouraged — only for a verified false positive):
#     git commit --no-verify
#
# The denylist holds HIGH-PRECISION tokens only (see the file's own
# header).  New real figures you start using should be added there.

root=$(git rev-parse --show-toplevel)
denylist="$root/.pii-denylist.txt"

# The denylist itself must never be committed.
if git diff --cached --name-only | grep -qx '.pii-denylist.txt'; then
  echo "pre-commit: refusing to commit .pii-denylist.txt (must stay local)." >&2
  exit 1
fi

[ -f "$denylist" ] || exit 0

# Staged ADDED lines only (new content being introduced).
#
# Machine-generated market-data caches are excluded from the scan:
# they contain exclusively yfinance output (dates, closes, split
# ratios, dividend amounts) — user data cannot appear in them by
# construction, and rounded public prices collide with short numeric
# denylist tokens by the birthday paradox (231 symbols × ~2000 daily
# closes at 6 significant digits minted exact matches for two
# denylisted figures the first time the sharded cache was committed).
# Every other path — exports, tests, docs, source — is still scanned
# with the full denylist.
added=$(git diff --cached --diff-filter=ACM -U0 -- . \
          ':(exclude)cache/prices/*' \
          ':(exclude)cache/price_cache.json' \
          ':(exclude)cache/dividends_cache.json' \
          ':(exclude)cache/splits_cache.json' \
        | grep '^+' | grep -v '^+++')
[ -n "$added" ] || exit 0

blocked=0
while IFS= read -r token || [ -n "$token" ]; do
  case "$token" in ''|'#'*) continue ;; esac
  hit=0
  case "$token" in
    *[!0-9.,]*)
      # Non-numeric token (email, account id) — plain substring match.
      printf '%s\n' "$added" | grep -Fq -- "$token" && hit=1
      ;;
    *)
      # Purely numeric token — require digit boundaries so it can't
      # fire inside the decimal expansion of an unrelated number
      # (a 6-digit token once matched the middle of a public market
      # price in cache/price_cache.json).  The real figure still
      # matches with $ / .00 / EOL around it — only an adjacent
      # DIGIT disqualifies the hit.
      esc=$(printf '%s' "$token" | sed 's/\./\\./g')
      printf '%s\n' "$added" | grep -Eq -- "(^|[^0-9])${esc}(\$|[^0-9])" && hit=1
      ;;
  esac
  if [ "$hit" -eq 1 ]; then
    if [ "$blocked" -eq 0 ]; then
      echo "pre-commit: BLOCKED — staged changes contain denylisted personal data:" >&2
      blocked=1
    fi
    echo "    $token" >&2
  fi
done < "$denylist"

if [ "$blocked" -ne 0 ]; then
  echo "" >&2
  echo "Use synthetic values (tests) or describe changes qualitatively." >&2
  echo "If this is a false positive, prune the token from .pii-denylist.txt." >&2
  exit 1
fi
exit 0
