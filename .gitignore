# Personal data — broker CSV exports, metadata.csv, and broker
# reference reports (Coinbase gain/loss + raw-tx) all stay local.
# `data/*` ignores every file of ANY extension under data/ (so a stray
# .bak / .xlsx / .txt can't leak) while still letting the .gitkeep
# through — a bare `data/` would ignore the dir itself and git couldn't
# re-include anything inside it.
# (samples/ is checked in — it's synthetic.)
data/*
!data/.gitkeep

# Local PII denylist consumed by the githooks/pre-commit guard —
# real emails / account ids / figures.  Must never be committed.
.pii-denylist.txt

# Generated artifacts
exports/
snap.json
# Locally-rendered sample dashboard (regenerate from samples/ — see README).
sample-dashboard.html

# Cache: every file in cache/ is checked in EXCEPT the run-state
# snapshot used for "What's Changed" diffs.  last_run.json captures
# portfolio totals and is regenerated every pipeline run.
cache/last_run.json

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp

# Claude Code — local per-machine settings (permission allowlists, etc.).
# Project skills under .claude/skills/ are intentionally NOT ignored.
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
