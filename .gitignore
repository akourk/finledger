# Personal data — broker CSV exports + your metadata.csv stay local.
# (samples/ is checked in — it's synthetic.)
data/*.csv
data/*.json

# Generated artifacts
exports/
snap.json
# Locally-rendered sample dashboard (regenerate from samples/ — see README).
sample-dashboard.html

# Cache: every file in cache/ is checked in EXCEPT the run-state
# snapshot used for "What's Changed" diffs.  last_run.json captures
# portfolio totals and is regenerated every pipeline run.
cache/last_run.json

