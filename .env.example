# Environment Configuration Template
# ==================================
# Copy this file to .env and customize for your setup
# The .env file is gitignored and won't be committed

# Data paths (optional - defaults to data/ directory)
# FIN_DATA_PATH=/path/to/your/data
# FIN_INPUT_PATH=/path/to/your/data/input
# FIN_OUTPUT_PATH=/path/to/your/data/output

# Cache settings
# FIN_CACHE_ENABLED=true
# FIN_CACHE_TTL_DAYS=30

# yfinance settings
# FIN_YFINANCE_TIMEOUT=10
# FIN_YFINANCE_RETRY_COUNT=3

# Logging
# FIN_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
# FIN_LOG_FILE=logs/fin.log

# Dashboard settings
# FIN_DASHBOARD_PORT=8000
# FIN_DASHBOARD_HOST=localhost

# Performance
# FIN_PARALLEL_PROCESSING=true
# FIN_MAX_WORKERS=4

# Privacy/Security
# FIN_ANONYMIZE_AMOUNTS=false  # Set to true to mask actual dollar amounts in exports
# FIN_REDACT_ACCOUNT_NUMBERS=true
